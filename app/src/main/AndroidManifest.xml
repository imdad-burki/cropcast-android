<?xml version="1.0" encoding="utf-8"?>
<!--
  CROPCAST manifest.
  Permissions are declared ONLY for features actually implemented (spec §11/§12).
  No INTERNET permission: nothing in the app needs it.
  MediaProjection consent is separate from these runtime permissions and is
  requested fresh for every capture session (spec §3.3, §11).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="CROPCAST"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cropcast">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Cropcast">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Recording foreground service (Phase 3). Type is declared here;
             the service itself is implemented in :service:recording. -->
        <service
            android:name="com.imdadburki.cropcast.service.recording.RecordingService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <!-- FileProvider for sharing recordings saved as plain files
             (API 26–28, or the private destination). Phase 6. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
